          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/activity/notifications/read-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "activity", "notifications", "read-all"]
            }
          }
        }
      ]
    }
  ]
}
