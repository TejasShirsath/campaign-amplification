        },
        {
          "name": "Get User's Own Feedback Votes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campaigns/{{campaignId}}/feedback/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campaigns", "{{campaignId}}", "feedback", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Notifications & Activity (Auth Required)",
      "item": [
        {
          "name": "Get Notifications Feed",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/activity/notifications?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "activity", "notifications"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Unread Notifications Count",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/activity/notifications/unread-count",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "activity", "notifications", "unread-count"]
            }
          }
        },
        {
          "name": "Mark Single Notification as Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/activity/notifications/{{notificationId}}/read",
